    {
      "cell_type": "markdown",
      "metadata": {
        "id": "cZ6oDj3CUbdq"
      },
      "source": [
        "*Exercise 11:* Develop a version of the game where one player is the computer.\n",
        "\n",
        "Note: you do **not** need an extensive search for the best move. For example, you can have the computer:\n",
        "- block obvious losses\n",
        "- otherwise try to create a winning row/column/diagonal\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "IYrbYipYUbdq"
      },
      "outputs": [],
      "source": [
        "def find_winning_move(board, mark):\n",
        "  n = len(board)\n",
        "  for i in range(n):\n",
        "    for j in range(n):\n",
        "      if board[i][j] == 0:\n",
        "        board[i][j] = mark\n",
        "        if check_winner(board) not in (-1, 0):\n",
        "          board[i][j] = 0\n",
        "          return (i, j)\n",
        "        board[i][j] = 0\n",
        "  return None\n",
        "\n",
        "def computer_move(board, player):\n",
        "  my_mark = \"X\" if player == 1 else \"O\"\n",
        "  opp_mark = \"O\" if player == 1 else \"X\"\n",
        "\n",
        "  move = find_winning_move(board, my_mark)      # 1. can I win?\n",
        "  if move is None:\n",
        "    move = find_winning_move(board, opp_mark)   # 2. block opponent's win\n",
        "\n",
        "  if move is None:                              # 3. otherwise first empty cell\n",
        "    n = len(board)\n",
        "    for i in range(n):\n",
        "      for j in range(n):\n",
        "        if board[i][j] == 0:\n",
        "          move = (i, j)\n",
        "          break\n",
        "      if move:\n",
        "        break\n",
        "\n",
        "  board[move[0]][move[1]] = my_mark\n",
        "\n",
        "\n"
      ]
    },
