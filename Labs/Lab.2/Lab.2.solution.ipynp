            "2 |   | X | X | \n",
            "   --- --- --- \n",
            "3 | X | O | O | \n",
            "   --- --- --- \n",
            "Computer (Player 2) is thinking...\n",
            "    A   B   C   \n",
            "   --- --- --- \n",
            "1 |   | X | O | \n",
            "   --- --- --- \n",
            "2 | O | X | X | \n",
            "   --- --- --- \n",
            "3 | X | O | O | \n",
            "   --- --- --- \n",
            "Player 1, enter your move: A1\n",
            "    A   B   C   \n",
            "   --- --- --- \n",
            "1 | X | X | O | \n",
            "   --- --- --- \n",
            "2 | O | X | X | \n",
            "   --- --- --- \n",
            "3 | X | O | O | \n",
            "   --- --- --- \n",
            "It's a draw!\n"
          ]
        }
      ],
      "source": [
        "def play_game_minimax(n=3, computer_player=2, max_depth=4):\n",
        "  board = create_board(n)\n",
        "  player = 1\n",
        "  while True:\n",
        "    draw_board(board)\n",
        "    if player == computer_player:\n",
        "      print(f\"Computer (Player {player}) is thinking...\")\n",
        "      computer_move_minimax(board, player, max_depth)\n",
        "    else:\n",
        "      playermove(board, player)\n",
        "\n",
        "    result = check_winner(board)\n",
        "    if result == 1:\n",
        "      draw_board(board); print(\"Player 1 (X) wins!\"); break\n",
        "    elif result == 2:\n",
        "      draw_board(board); print(\"Player 2 (O) wins!\"); break\n",
        "    elif result == 0:\n",
        "      draw_board(board); print(\"It's a draw!\"); break\n",
        "    player = 2 if player == 1 else 1\n",
        "\n",
        "play_game_minimax(3, computer_player=2, max_depth=9)  # 9 = perfect play on 3x3"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "IZey4vE2Ubdr"
      },
      "source": [
        "*Exercise 13:* Make the 2 computer players play each-other for 10 games on a 3x3, then 4x4, then 5x5 grid. Set the max depth so that the games only take seconds. Measure the \"smarter\" player's win rate for each grid."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 45,
      "metadata": {
        "id": "HDu9Vgs7Ubdr"
      },
      "outputs": [],
      "source": [
        "def play_computer_vs_computer(n, depth_p1, depth_p2):\n",
        "  board = create_board(n)\n",
        "  player = 1\n",
        "  while True:\n",
        "    depth = depth_p1 if player == 1 else depth_p2\n",
        "    computer_move_minimax(board, player, depth)\n",
        "    result = check_winner(board)\n",
        "    if result in (0, 1, 2):\n",
        "      return result\n",
        "    player = 2 if player == 1 else 1\n",
        "\n",
        "def run_experiment(n, games, depth_p1, depth_p2):\n",
        "  wins1 = wins2 = draws = 0\n",
        "  for _ in range(games):\n",
        "    result = play_computer_vs_computer(n, depth_p1, depth_p2)\n",
        "    if result == 1: wins1 += 1\n",
        "    elif result == 2: wins2 += 1\n",
        "    else: draws += 1\n",
        "\n",
        "  print(f\"n={n}: Player 1 (depth={depth_p1}) win rate: {wins1/games:.0%} | \"\n",
        "        f\"Player 2 (depth={depth_p2}) win rate: {wins2/games:.0%} | \"\n",
        "        f\"Draws: {draws/games:.0%}\")\n",
        "\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 46,
      "metadata": {
        "id": "v3XqWI6bUbdr",
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
