          "name": "stdout",
          "text": [
            "n=3: Player 1 (depth=9) win rate: 60% | Player 2 (depth=1) win rate: 0% | Draws: 40%\n",
            "n=4: Player 1 (depth=5) win rate: 0% | Player 2 (depth=1) win rate: 0% | Draws: 100%\n",
            "n=5: Player 1 (depth=3) win rate: 0% | Player 2 (depth=1) win rate: 0% | Draws: 100%\n"
          ]
        }
      ],
      "source": [
        "run_experiment(3, 10, 9, 1)\n",
        "run_experiment(4, 10, 5, 1)\n",
        "run_experiment(5, 10, 3, 1)"
