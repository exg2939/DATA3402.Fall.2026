      ],
      "source": [
        "def play_game_vs_computer(n=3, computer_player=2):\n",
        "  board = create_board(n)\n",
        "  player = 1\n",
        "  while True:\n",
        "    draw_board(board)\n",
        "    if player == computer_player:\n",
        "      print(f\"Computer (Player {player}) is moving...\")\n",
        "      computer_move(board, player)\n",
        "    else:\n",
        "      playermove(board, player)\n",
        "\n",
        "    result = check_winner(board)\n",
        "    if result == 1:\n",
        "      draw_board(board); print(\"Player 1 (X) wins!\"); break\n",
        "    elif result == 2:\n",
        "      draw_board(board); print(\"Player 2 (O) wins!\"); break\n",
        "    elif result == 0:\n",
        "      draw_board(board); print(\"It's a draw!\"); break\n",
        "    player = 2 if player == 1 else 1\n",
        "\n",
        "play_game_vs_computer(3, computer_player=2)"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "2tB08iMqUbdr"
      },
      "source": [
        "*Exercise 12:* Develop a version of the game where one player is the computer. This time, write a computer player using exhaustive search with a max depth parameter, similar to lecture."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 43,
      "metadata": {
        "id": "sfVS8bf3Ubdr"
      },
      "outputs": [],
      "source": [
        "def get_empty_cells(board):\n",
        "  n = len(board)\n",
        "  return [(i, j) for i in range(n) for j in range(n) if board[i][j] == 0]\n",
        "\n",
        "def evaluate_board(board, player):\n",
        "  opponent = 2 if player == 1 else 1\n",
        "  my_mark = \"X\" if player == 1 else \"O\"\n",
        "  opp_mark = \"X\" if opponent == 1 else \"O\"\n",
        "  n = len(board)\n",
        "\n",
        "  lines = list(board) + list(zip(*board))\n",
        "  lines.append([board[i][i] for i in range(n)])\n",
        "  lines.append([board[i][n-1-i] for i in range(n)])\n",
        "\n",
        "  score = 0\n",
        "  for line in lines:\n",
        "    my_count, opp_count = line.count(my_mark), line.count(opp_mark)\n",
        "    if opp_count == 0: score += my_count\n",
        "    if my_count == 0: score -= opp_count\n",
        "  return score\n",
        "\n",
        "def minimax(board, player, current_turn, depth, max_depth):\n",
        "  result = check_winner(board)\n",
        "  if result == player: return 100 + depth\n",
        "  if result == (2 if player == 1 else 1): return -100 - depth\n",
        "  if result == 0: return 0\n",
        "  if depth >= max_depth: return evaluate_board(board, player)\n",
        "\n",
        "  empty_cells = get_empty_cells(board)\n",
        "  mark = \"X\" if current_turn == 1 else \"O\"\n",
        "  next_turn = 2 if current_turn == 1 else 1\n",
        "\n",
        "  scores = []\n",
        "  for (i, j) in empty_cells:\n",
        "    board[i][j] = mark\n",
        "    scores.append(minimax(board, player, next_turn, depth + 1, max_depth))\n",
        "    board[i][j] = 0\n",
        "\n",
        "  return max(scores) if current_turn == player else min(scores)\n",
        "\n",
        "import random\n",
        "\n",
        "def computer_move_minimax(board, player, max_depth=4):\n",
        "  mark = \"X\" if player == 1 else \"O\"\n",
        "  next_turn = 2 if player == 1 else 1\n",
        "\n",
        "  best_score = float(\"-inf\")\n",
        "  best_moves = []\n",
        "\n",
        "  for (i, j) in get_empty_cells(board):\n",
        "    board[i][j] = mark\n",
        "    score = minimax(board, player, next_turn, 1, max_depth)\n",
        "    board[i][j] = 0\n",
        "\n",
        "    if score > best_score:\n",
        "      best_score = score\n",
        "      best_moves = [(i, j)]\n",
        "    elif score == best_score:\n",
        "      best_moves.append((i, j))\n",
        "\n",
        "  move = random.choice(best_moves)\n",
        "  board[move[0]][move[1]] = mark"
      ]
    },
